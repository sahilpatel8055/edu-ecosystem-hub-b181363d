    "do_not_invent": [
      "fees",
      "deadlines",
      "scholarship percentages",
      "placement percentages",
      "salary figures",
      "accreditation status",
      "specialisations",
      "semester subjects"
    ],
    "fallback_logic": "If university-specific curriculum is unavailable, show the common course curriculum with a visible 'Common curriculum reference' label and a source/verification note. Do not fabricate university-specific subjects.",
    "content_deduplication": "University-level facts belong on the university pillar. Course pages may repeat concise verified facts needed for user decision-making, but should add course-specific context, curriculum, specialisation, eligibility, fees, exam, admission and career information.",
    "editorial_tone": "Clear, neutral, student-friendly, evidence-led. Avoid 'best', 'No.1', 'guaranteed placement', or salary promises unless a dated, authoritative source supports the claim."
  },
