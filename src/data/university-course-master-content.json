  "page_structure": {
    "title": "University × Course Master Page",
    "url_pattern": "/university/{university-slug}/{course-slug}",
    "indexable_rule": "Index the main university-course page when it has unique, useful programme information. Do not create thin indexable pages for every section.",
    "sections": [
      {
        "id": "hero",
        "h1": "{University} Online {Course}: Fees, Admission, Eligibility, Syllabus & Career",
        "content": "University-specific facts, duration, mode, fee, key recognition and primary CTA."
      },
      {
        "id": "overview",
        "heading": "{University} Online {Course} Overview",
        "content": "300-500 words; explain programme, learner fit, delivery, duration and outcomes without generic filler."
      },
      {
        "id": "recognition",
        "heading": "Approvals, Recognition & Accreditation",
        "content": "Only verified claims; distinguish UGC entitlement, AICTE approval, NAAC accreditation and rankings."
      },
      {
        "id": "specialisations",
        "heading": "{Course} Specialisations at {University}",
        "content": "University-specific list. Each specialisation links to an anchor or dedicated page only if enough unique content exists."
      },
      {
        "id": "fees",
        "heading": "{University} Online {Course} Fees",
        "content": "Total fee, semester fee, one-time fee, exam fee, EMI/scholarship notes, verified date."
      },
      {
        "id": "curriculum",
        "heading": "{University} Online {Course} Curriculum & Syllabus",
        "content": "Use official university curriculum where available. Otherwise use the common course curriculum as the fallback and label it as common/reference curriculum. Specialisation modules appear as electives."
      },
      {
        "id": "eligibility",
        "heading": "Eligibility Criteria",
        "content": "Qualification, minimum marks, entrance/aptitude requirements, work experience, nationality/international requirements."
      },
      {
        "id": "admission",
        "heading": "Online Admission Process",
        "content": "1 programme selection, 2 application, 3 document upload, 4 fee payment, 5 confirmation/LMS activation. Replace generic steps with university-specific process where verified."
      },
      {
        "id": "exam",
        "heading": "Examination Pattern",
        "content": "Assessment split, exam mode, proctoring, passing rules and exam schedule; verify programme-specific rules."
      },
      {
        "id": "scholarship",
        "heading": "Scholarships & Financial Support",
        "content": "Only verified categories/amounts; include eligibility criteria and validity date."
      },
      {
        "id": "learning",
        "heading": "Learning Experience & LMS",
        "content": "Live classes, recorded lectures, LMS, doubt support, study material, assessments and flexibility where verified."
      },
      {
        "id": "degree",
        "heading": "Degree, Certificate & Academic Value",
        "content": "Explain what credential is awarded and recognition/equivalence only when supported."
      },
      {
        "id": "career",
        "heading": "Career Opportunities After {Course}",
        "content": "Map course/specialisation to realistic job families; do not promise salary or placement."
      },
      {
        "id": "placement",
        "heading": "Placement & Career Support",
        "content": "Separate 'placement assistance' from guaranteed placement. Show hiring partners only if university officially publishes them."
      },
      {
        "id": "pros-cons",
        "heading": "Pros, Limitations & Who Should Choose It",
        "content": "Balanced decision-support content; no promotional-only copy."
      },
      {
        "id": "comparison",
        "heading": "{University} Online {Course} vs Other Universities",
        "content": "Compare fee, duration, specialisations, curriculum, assessment, support and recognition only using verified data."
      },
      {
        "id": "faq",
        "heading": "Frequently Asked Questions",
        "content": "10-18 programme-specific questions generated from real search intent. Answers must match page facts."
      }
    ],
    "seo_rules": {
      "one_primary_h1": true,
      "canonical": "Self-canonical for the main university-course URL.",
      "section_urls": "Use one indexable main page with hash anchors for sections. Do NOT create separate indexable URLs for every section merely to target keywords.",
      "specialisation_urls": "Create /specialisation child URLs only when the page has substantial unique content; otherwise use anchors.",
      "duplicate_control": "University pillar page explains university-level facts; university-course page explains course-specific facts. Reuse factual data through structured components, but rewrite contextual copy and avoid identical long paragraphs.",
      "breadcrumbs": "Home > Universities > {University} > Online {Course}.",
      "internal_links": [
        "university pillar",
        "course pillar",
        "other courses at same university",
        "same course at other universities",
        "specialisation pages where substantial"
      ],
      "schema": [
        "BreadcrumbList",
        "Course where valid",
        "FAQPage only when visible FAQ content meets search-engine requirements",
        "Organization/CollegeOrUniversity where appropriate"
      ],
      "freshness": "Store last_verified_at and source_url(s) for every volatile field such as fee, scholarship, admission deadline, ranking and exam rules."
    }
  },
  "data_quality_rules": {
    "source_priority": [
      "Official university programme page / official prospectus / official syllabus PDF",
      "UGC/DEB or other statutory regulator source for recognition",
      "Official university fee/scholarship/admission policy",
      "Reputable secondary education platform for cross-checking only"
